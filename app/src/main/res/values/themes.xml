<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.MeuIPTV" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/brand_green</item>
        <item name="colorPrimaryDark">@color/brand_green_dark</item>
        <item name="colorAccent">@color/brand_green</item>
        <item name="android:windowBackground">@color/background_light</item>
        <item name="android:statusBarColor" tools:targetApi="21">@color/brand_green_dark</item>
    </style>

    <style name="Theme.MeuIPTV.Player" parent="Theme.MaterialComponents.NoActionBar">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:statusBarColor">@android:color/black</item>
        <item name="android:windowFullscreen">true</item>
    </style>
</resources>
